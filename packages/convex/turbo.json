{
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": [
        "VITE_CLERK_FRONTEND_API_URL",
        "GOOGLE_CALENDAR_CLIENT_ID",
        "GOOGLE_CALENDAR_CLIENT_SECRET",
        "GOOGLE_CALENDAR_APP_URL",
        "CALENDAR_ENCRYPTION_KEY",
        "CONVEX_SITE_URL"
      ],
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "passThroughEnv": [
        "AI_MODEL_REVIEWS",
        "AI_OWNER_SUBJECT",
        "AI_OWNER_FUNDED_SUBJECTS",
        "AI_KEY_ENCRYPTION_SECRET",
        "AI_OPENAI_KEY",
        "AI_ANTHROPIC_KEY",
        "AI_GEMINI_KEY"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
